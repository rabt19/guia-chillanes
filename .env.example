# ============================================================================
# Copia este archivo a .env y ajusta los valores. NO subas .env a GitHub.
# ============================================================================

# Postgres
POSTGRES_USER=guia
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_DB=guia_chillanes
DATABASE_URL=postgres://guia:cambia_esta_clave@postgres:5432/guia_chillanes

# JWT (clave para firmar los tokens de sesión) — pon una cadena larga y aleatoria
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria

# Nombre que aparece en la app de autenticación para el 2FA
TOTP_ISSUER=Guia Chillanes

# Administrador inicial (se crea solo la primera vez que arranca auth-service)
ADMIN_NOMBRE=Rene Barragan
ADMIN_EMAIL=rabt19@gmail.com
ADMIN_PASSWORD=cambia_esta_clave_de_admin

# Puertos internos de los microservicios (no suele hacer falta cambiarlos)
AUTH_PORT=4001
NEGOCIOS_PORT=4002
TRANSPORTE_PORT=4003
GATEWAY_PORT=8080

# URL pública del gateway que usará el frontend (en local: http://localhost:8080)
VITE_API_URL=http://localhost:8080
